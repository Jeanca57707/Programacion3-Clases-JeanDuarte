<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ConsultarController">
   <top>
      <HBox prefHeight="85.0" prefWidth="600.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Consulta de Productos">
               <padding>
                  <Insets left="20.0" top="40.0" />
               </padding>
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <ComboBox fx:id="categorias" prefWidth="150.0">
               <HBox.margin>
                  <Insets left="140.0" top="40.0" />
               </HBox.margin>
            </ComboBox>
            <Button fx:id="btnFiltrar" mnemonicParsing="false" onAction="#filtrarPorCat" prefHeight="25.0" prefWidth="60.0" text="Filtrar">
               <HBox.margin>
                  <Insets top="40.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox prefHeight="29.0" prefWidth="600.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
            <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#close" prefHeight="25.0" prefWidth="59.0" text="Cerrar" />
            <Label fx:id="valorTotal" prefHeight="22.0" prefWidth="243.0" text="Label">
               <padding>
                  <Insets left="25.0" top="5.0" />
               </padding>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label fx:id="mensaje" prefHeight="22.0" prefWidth="147.0" text="Label">
               <padding>
                  <Insets top="5.0" />
               </padding>
            </Label>
         </children>
         <padding>
            <Insets bottom="5.0" left="15.0" top="5.0" />
         </padding>
      </HBox>
   </bottom>
   <center>
      <TableView fx:id="productos" prefHeight="286.0" prefWidth="429.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="nombreProd" minWidth="0.0" prefWidth="150.0" text="Nombre" />
          <TableColumn fx:id="categoriaProd" prefWidth="150.0" text="Categoría" />
            <TableColumn fx:id="precioProd" prefWidth="150.0" text="Precio" />
            <TableColumn fx:id="cantidadProd" prefWidth="150.0" text="Cantidad" />
        </columns>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </padding>
      </TableView>
   </center>
</BorderPane>
